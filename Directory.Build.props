<Project>
  <!--
    One version and one set of schema numbers for every Foton v2 project.
    Bump FotonVersion (and the schema you changed) on behavior or format changes.
    Schema numbers start where 1.38.x left them; the port changes them only with a disclosed reason.
  -->
  <PropertyGroup>
    <FotonVersion>3.2.1</FotonVersion>
    <!-- Empty for a release (tag v$(FotonVersion)); set it (alpha.1, beta.1) for a prerelease tag v$(FotonVersion)-$(FotonPrerelease). -->
    <FotonPrerelease></FotonPrerelease>
    <!-- UTC date of the change that set FotonVersion; the banner shows it as Updated. -->
    <FotonReleaseDate>2026-11-14</FotonReleaseDate>
    <!-- 1.14.0: same files, tasks, and columns as 1.13.0; values change (UTC timestamps, AccessDenied / SkippedUnc /
         SupersededBySave statuses, rows 1.38.x missed such as user-hive autoruns and Active WDAC policies).
         1.15.0: collection profiles add the NotSelected task status, 00_Collection\collection_profile.json, and profile
         fields in collection_coverage.json; a package collected without a profile has the 1.14.0 layout.
         1.16.0: the -Deep gpresult_html task also writes 06_Security_Posture\gpresult.xml (gpresult /x), a second row in its CSV. -->
    <FotonCollectSchemaVersion>1.16.0</FotonCollectSchemaVersion>
    <!-- 1.15.0-1.18.0 keep identity keys, so Compare accepts 1.14.0 and later against each other (BaselineSchema). 1.16.0:
         WinsockLsp Namespace64. 1.17.0: Service ServiceDll compared (skipped against older baselines that lack it).
         1.18.0: SystemBinary pwsh.exe from Program Files\PowerShell\7. -->
    <FotonBaselineSchemaVersion>1.18.0</FotonBaselineSchemaVersion>
    <FotonFindingsSchemaVersion>1.0.0</FotonFindingsSchemaVersion>
    <!-- analysis\examiner_notes.json (examiner input, never findings). A reader refuses another major version. -->
    <FotonNotesSchemaVersion>1.0.0</FotonNotesSchemaVersion>

    <Version Condition="'$(FotonPrerelease)' == ''">$(FotonVersion)</Version>
    <Version Condition="'$(FotonPrerelease)' != ''">$(FotonVersion)-$(FotonPrerelease)</Version>
    <AssemblyVersion>$(FotonVersion).0</AssemblyVersion>
    <FileVersion>$(FotonVersion).0</FileVersion>
    <Product>Foton</Product>
    <Company>JDI Consulting</Company>
    <Authors>jimididit</Authors>
    <Copyright>Copyright (c) 2026 jimididit</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <!-- In-box on Windows 10 / Server 2016+, so endpoints install nothing. -->
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <!-- 64-bit on 64-bit Windows: a 32-bit process is redirected to SysWOW64 and the 32-bit registry view. -->
    <Prefer32Bit>false</Prefer32Bit>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <DebugType>embedded</DebugType>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Only cli projects reference ILRepack (cli\Directory.Build.targets); this makes them merge in every configuration. -->
    <ILRepackTargetsFile>$(MSBuildThisFileDirectory)cli\ILRepack.targets</ILRepackTargetsFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runtime reads these (FotonVersion); every assembly carries them so ILRepack keeps them on the merged exe. -->
    <AssemblyMetadata Include="FotonCollectSchemaVersion" Value="$(FotonCollectSchemaVersion)" />
    <AssemblyMetadata Include="FotonBaselineSchemaVersion" Value="$(FotonBaselineSchemaVersion)" />
    <AssemblyMetadata Include="FotonFindingsSchemaVersion" Value="$(FotonFindingsSchemaVersion)" />
    <AssemblyMetadata Include="FotonNotesSchemaVersion" Value="$(FotonNotesSchemaVersion)" />
    <AssemblyMetadata Include="FotonReleaseDate" Value="$(FotonReleaseDate)" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
  </ItemGroup>
</Project>
