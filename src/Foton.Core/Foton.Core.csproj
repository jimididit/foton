<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Shared by all three executables: session, task runner, manifest, writers, hashing, package files.
    No live-host access here (that is Foton.Win): facts about the host arrive as plain values.
  -->
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>
  <ItemGroup>
    <!-- Data, not code: the registry hardening table Collect and Baseline read (same file as 1.38.x Patterns). -->
    <EmbeddedResource Include="Resources\HardeningRegistryChecks.csv" LogicalName="Foton.Core.HardeningRegistryChecks.csv" />
  </ItemGroup>
</Project>
