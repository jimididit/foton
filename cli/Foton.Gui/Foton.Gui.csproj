<Project Sdk="Microsoft.NET.Sdk">
  <!--
    foton-console.exe: the workstation GUI. It calls the same runners as foton.exe in process and never touches a live
    host (no Foton.Win, Foton.Collect, or Foton.Baseline.Capture; architecture tests enforce it). Foton.Win.Ui gives it
    the dark title bar and scroll bars and nothing else. WinForms, because it
    is in-box on .NET Framework 4.6.2 and merges into one file with ILRepack.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>foton-console</AssemblyName>
    <RootNamespace>Foton.Gui</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Foton.Core\Foton.Core.csproj" />
    <ProjectReference Include="..\..\src\Foton.Package\Foton.Package.csproj" />
    <ProjectReference Include="..\..\src\Foton.Parse\Foton.Parse.csproj" />
    <ProjectReference Include="..\..\src\Foton.Analyze\Foton.Analyze.csproj" />
    <ProjectReference Include="..\..\src\Foton.Patterns\Foton.Patterns.csproj" />
    <ProjectReference Include="..\..\src\Foton.Tools\Foton.Tools.csproj" />
    <ProjectReference Include="..\..\src\Foton.Baseline.Compare\Foton.Baseline.Compare.csproj" />
    <ProjectReference Include="..\..\src\Foton.Win.Ui\Foton.Win.Ui.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The window's own icon (title bar, taskbar at every size); the file icon comes from cli\Directory.Build.targets. -->
    <EmbeddedResource Include="..\..\assets\brand\icons\foton-console.ico" LogicalName="Foton.Gui.foton-console.ico" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <Import Project="..\EmbedCollectors.targets" />
</Project>
