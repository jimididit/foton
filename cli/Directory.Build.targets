<Project>
  <!--
    Each endpoint/workstation role ships as ONE file: project DLLs are merged into the exe at build
    time (ILRepack) and the merged inputs are deleted. Never embed DLLs as resources and load them with
    Assembly.Load(byte[]) - .NET Framework 4.8 AMSI scans that path and it looks like a malware loader.
  -->
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>
  <!-- Each executable's own icon (assets\brand\icons\<AssemblyName>.ico): Explorer, the taskbar, and Alt+Tab show it;
       ILRepack keeps the exe's own resources. A new executable needs an icon of its assembly name there (IconRules). -->
  <PropertyGroup>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\assets\brand\icons\$(AssemblyName).ico</ApplicationIcon>
  </PropertyGroup>
</Project>
