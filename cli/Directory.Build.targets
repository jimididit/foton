<Project>
  <!--
    Each endpoint/workstation role ships as ONE file: project DLLs are merged into the exe at build
    time (ILRepack) and the merged inputs are deleted. Never embed DLLs as resources and load them with
    Assembly.Load(byte[]) - .NET Framework 4.8 AMSI scans that path and it looks like a malware loader.
  -->
  <ItemGroup>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" PrivateAssets="all" />
  </ItemGroup>
  <!-- The Foton icon (assets\brand): Explorer, the taskbar, and Alt+Tab show it; ILRepack keeps the exe's own resources. -->
  <PropertyGroup>
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\assets\brand\foton.ico</ApplicationIcon>
  </PropertyGroup>
</Project>
