<?xml version="1.0" encoding="utf-8"?>
<!-- Build-time packages only (reference assemblies, ILRepack, test framework). Executables ship no NuGet DLLs. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
